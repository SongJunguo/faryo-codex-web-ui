[Unit]
Description=Faryo Owner
After=network-online.target faryo-appserver.service
Wants=network-online.target faryo-appserver.service
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
WorkingDirectory=@FARYO_ROOT_PATH@
Environment="FARYO_HOME=@FARYO_HOME@"
Environment="FARYO_INSTALL_ROOT=@FARYO_ROOT@"
Environment="FARYO_CODEX_APP_SERVER_UNIT=faryo-appserver.service"
ExecStart="@FARYO_PYTHON@" -m faryo_cli internal run-owner
Restart=on-failure
RestartSec=3
TimeoutStopSec=8
# tmux may be first spawned by Owner and therefore share this service cgroup.
# Restart only the web bridge; user tmux/Codex processes must survive updates.
KillMode=process
UMask=0077

[Install]
WantedBy=default.target
